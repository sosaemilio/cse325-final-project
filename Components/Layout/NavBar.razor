
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<nav>
        <a href="">
            <h2>Fragrance Vault</h2>
        </a>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="browse">
                        Browse
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="dashboard">
                        Profile
                    </NavLink>
                </li>
            </ul>
        </div>

        
        <AuthorizeView>

  
            <Authorized>
                <div class="user-dropdown">

                    <button class="btn-primary" @onclick="ToggleMenu">
                        @firstName ▼
                    </button>

                    @if (showMenu)
                    {
                        <div class="dropdown-menu">
                            <form method="post" action="/api/auth/logout">
                                <button type="submit">Logout</button>
                            </form>
                        </div>
                    }

                </div>
            </Authorized>

        
            <NotAuthorized>
                <div class="auth-buttons">

                    <button class="btn-secondary" @onclick='() => Navigation.NavigateTo("/login")'>
                       Log-in
                    </button>

                    <button class="btn-primary" @onclick='() => Navigation.NavigateTo("/register")'>
                        Register
                    </button>

                </div>
            </NotAuthorized>

        </AuthorizeView>

</nav>


@code {

    private string firstName = "User";
    private bool showMenu = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            firstName = user.FindFirst("FirstName")?.Value ?? "User";
        }
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }
}
