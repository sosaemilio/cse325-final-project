@page "/fragrance/{Id:int}"
@rendermode InteractiveServer

@inject AppDbContext _context
@inject AuthenticationStateProvider AuthStateProvider

@inject NavigationManager Navigation

@using FragranceVault.Models
@using Microsoft.AspNetCore.Components.Authorization
@using FragranceVault.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>@fragrance?.Name</PageTitle>

@if (fragrance == null)
{
    <p>Loading...</p>
}
else
{
    <div class="details">

        @if (!string.IsNullOrEmpty(fragrance.ImageUrl))
        {   
            <div class="details-image">
                <img src="@fragrance.ImageUrl" />
            </div>
        }

        <div class="details-info">
            <h1>@fragrance.Name</h1>
            <div class="details-meta">
                <p><b>Brand:</b> @fragrance.Brand</p>
                <p><b>Notes:</b> @fragrance.Notes</p>
                <p><b>Season:</b> @fragrance.Season</p>
                <p><b>Occasion:</b> @fragrance.Occasion</p>
            </div>
            <hr />

            <h3>Want to add it to the vault?</h3>
            <div class="luxe-input-wrapper">
                <input type="text" id="notesField" class="luxe-input" placeholder=" " autocomplete="off" @bind="notes" />
                <label for="notesField" class="luxe-label">Notes</label>
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper" style="margin-top: 32px;">
                <input type="text" id="seasonField" class="luxe-input" placeholder=" " autocomplete="off" @bind="season" />
                <label for="seasonField" class="luxe-label">Season</label>
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper" style="margin-top: 32px;">
                <input type="text" id="occasionField" class="luxe-input" placeholder=" " autocomplete="off" @bind="occasion" />
                <label for="occasionField" class="luxe-label">Occasion</label>
                <span class="luxe-underline"></span>
            </div>

            <br />

            <div class=button-container>
                <button @onclick="AddToVault" class="btn-primary">Add to Vault</button>
                <p>@message</p>
            </div>
            
        </div>
    </div>
}

@code {

    // Route parameter used to identify which fragrance to display
    [Parameter] public int Id { get; set; }

    // Holds the selected fragrance details
    private Fragrance? fragrance;

    // User input fields for customizing the vault item
    private string notes = "";
    private string season = "";
    private string occasion = "";

    // Message displayed to the user (success or error feedback)
    private string message = "";

    // Runs when the component is initialized
    protected override async Task OnInitializedAsync()
    {
        // Load the fragrance details based on the provided ID
        await LoadFragrance();
    }

    // Loads the selected fragrance from the database
    private async Task LoadFragrance()
    {
        // Find the fragrance by its ID
        fragrance = await _context.Fragrances.FindAsync(Id);

        // If found, populate default values for customization fields
        if (fragrance != null)
        {
            notes = fragrance.Notes ?? "";
            season = fragrance.Season ?? "";
            occasion = fragrance.Occasion ?? "";
        }
    }

    // Adds the selected fragrance to the user's vault
    private async Task AddToVault()
    {
        // Ensure fragrance exists before proceeding
        if (fragrance == null) return;

        // Retrieve authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Get the current user's ID
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        // If user is not logged in, show error message
        if (string.IsNullOrEmpty(userId))
        {
            message = "Not logged in";
            return;
        }

        // Check if this fragrance already exists in the user's vault
        var exists = await _context.VaultItems
            .AnyAsync(v => v.UserId == userId && v.FragranceId == fragrance.Id);

        // Prevent duplicate entries
        if (exists)
        {
            message = "This fragrance is already in your vault";
            return;
        }

        // Create a new vault item with user-provided and default values
        var item = new VaultItem
        {
            UserId = userId,
            FragranceId = fragrance.Id,
            BuyDate = DateTime.Now,
            ExpirationDate = DateTime.Now.AddYears(2),

            // Custom user inputs
            PersonalNotes = notes,
            Season = season,
            Occasion = occasion,
            Rating = 0
        };

        // Save the new item to the database
        _context.VaultItems.Add(item);
        await _context.SaveChangesAsync();

        // Provide success feedback to the user
        message = "Added to your vault";

        // Redirect back after adding
        Navigation.NavigateTo("/browse");
    }
}
