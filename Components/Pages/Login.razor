@page "/login"
@layout AuthLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - Fragance Vault</PageTitle>

<div class="login-header">
    <img src="/images/sample-images/login.png" alt="Logo" class="login-logo" />
</div>

<div class="login-card">

    <div class="login-header">
        <h2>LOG IN</h2>
        <p>Enter the vault to access your curated collection.</p>
    </div>

    <!-- ✅ FORM (IMPORTANT FOR AUTH) -->
    <form method="post" action="/api/auth/login" name="loginForm">

        <div class="form-group">
            <label>Email Address</label>
            <input name="Email"
                   class="form-control-custom"
                   placeholder="name@example.com" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input name="Password"
                   type="password"
                   class="form-control-custom"
                   placeholder="••••••••" />
        </div>

        <button type="submit" class="btn-login">
            ENTER VAULT
        </button>

    

    </form>
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="validation-error">@message</p>
        }

    <div class="login-footer">
        <p>
            Don't have an account?
            <a href="/register">Register</a>
        </p>
    </div>

</div>

@code {
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/dashboard", true);
        }

       
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        if (uri.Query.Contains("error=invalid"))
        {
            message = "❌ Invalid email or password";
        }
    }
}