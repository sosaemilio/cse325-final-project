@page "/login"
@layout AuthLayout
@rendermode InteractiveServer

@using FragranceVault.DTOs  
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Login - Fragance Vault</PageTitle>

<div class="login-header">
    <img src="/images/sample-images/login.png" alt="Logo" class="login-logo" />
</div>

<!-- 💡 Wrap everything inside the card layout container -->
<div class="login-card">
    <div class="login-header">
        <h2 class="headline-md">LOG IN</h2>
        <p class="body-md">Enter the vault to access your curated collection.</p>
    </div>

    <EditForm Model="@loginCredentials" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="email">Email Address</label>
            <InputText id="email" class="form-control-custom" @bind-Value="loginCredentials.Email" placeholder="name@example.com" />
            <ValidationMessage For="@(() => loginCredentials.Email)" class="validation-error" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" type="password" class="form-control-custom" @bind-Value="loginCredentials.Password" placeholder="••••••••" />
            <ValidationMessage For="@(() => loginCredentials.Password)" class="validation-error" />
        </div>

        <!-- 💡 Swapped class to btn-login to instantly connect your CSS styles -->
        <button type="submit" class="btn-login">ENTER VAULT</button>
    </EditForm>
    
    <div class="login-footer">
        <p>Don't have an account? <a href="/register">Register</a></p>
    </div>
</div>


@code {
    private LoginDto loginCredentials = new LoginDto();
    private string errorMessage = ""; // Add this to display backend errors to the user

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/dashboard", true);
        }
    }

    private async Task HandleLogin()
    {
        Console.WriteLine($"Form submitted successfully for: {loginCredentials.Email} ✅");
        errorMessage = ""; 

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login", loginCredentials);
            
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Login API request succeeded!");
                
                Navigation.NavigateTo("/dashboard", true);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrEmpty(content) ? content : "Invalid email or password.";
                Console.WriteLine($"Login failed: {errorMessage} ");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A server connection error occurred.";
            Console.WriteLine($"Database or network connection exception: {ex.Message}");
        }
    }
}