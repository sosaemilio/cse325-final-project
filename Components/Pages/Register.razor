@page "/register"
@layout AuthLayout
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation

@using FragranceVault.DTOs

<PageTitle>Register - Fragance Vault</PageTitle>

<div class="login-header">
    <img src="/images/sample-images/login.png" alt="Logo" class="login-logo" />
</div>

<div class="register-card">
    <div class="register-header">
        <h2>Create Account</h2>
        <p>Join us to manage your personal vault</p>
    </div>

    <div class="form-group">
        <label for="firstName">First Name</label>
        <input id="firstName" name="firstName" @bind="model.FirstName" class="form-control-custom" placeholder="Emilio" required />
    </div>

    <div class="form-group">
        <label for="lastName">Last Name</label>
        <input id="lastName" name="lastName" @bind="model.LastName" class="form-control-custom" placeholder="Silva" required />
    </div> 

    <div class="form-group">
        <label for="email">Email Address</label>
        <input id="email" name="email" @bind="model.Email" class="form-control-custom" placeholder="name@example.com" type="email" required />
    </div>

    <div class="form-group">
        <label for="password">Password</label>
        <input id="password" name="password" @bind="model.Password" class="form-control-custom" placeholder="••••••••" type="password" required />
    </div>

    <button class="btn-register" @onclick="RegisterUser">Register</button>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="validation-error">@message</p>
    }

    <div class="register-footer">
        <p>Already have an account? <a href="/login">Sign In</a></p>
    </div>
</div>

@code {
    // Model bound to the registration form inputs
    private RegisterDto model = new RegisterDto();

    // Message displayed to the user (errors or feedback)
    private string message = "";

    // Handles user registration when the form is submitted
    private async Task RegisterUser()
    {
        // Debug log to confirm button click
        Console.WriteLine("BUTTON CLICKED");

        // Send registration request to the backend API
        var response = await Http.PostAsJsonAsync("/api/auth/register", model);

        // Read raw response content (useful for debugging)
        var content = await response.Content.ReadAsStringAsync();
        Console.WriteLine(content);

        // If registration succeeds
        if (response.IsSuccessStatusCode)
        {
            // Redirect user to login page
            Navigation.NavigateTo("/login", true);
        }
        else
        {
            // Attempt to read list of error messages from the response
            var errors = await response.Content.ReadFromJsonAsync<List<string>>();

            // If errors exist, display them to the user
            if (errors != null && errors.Count > 0)
            {
                message = string.Join("\n", errors);
            }
            else
            {
                // Fallback error message if none are returned
                message = "Registration failed";
            }
        }
    }
}