@page "/vault"
@rendermode InteractiveServer

@inject AppDbContext _context
@inject AuthenticationStateProvider AuthStateProvider


@using FragranceVault.Models
@using FragranceVault.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation

<PageTitle>My Vault</PageTitle>
<h1>My Fragance Vault</h1>

<div class="vault-header">
    <p>Total Bottles: @vault.Count</p>
    <button @onclick = '() => Navigation.NavigateTo($"/browse")' class="btn-secondary">
        Browse
    </button>
</div>


<div class="vault-grid">
    @foreach (var item in vault)
    {
        <div class="vault-card" @onclick='() => Navigation.NavigateTo($"/vault/{item.Id}")'>

            <img src="@item.Fragrance?.ImageUrl" alt="@item.Fragrance?.Name - @item.Fragrance?.Brand"/>
        
            <h2>@item.Fragrance?.Name</h2>
            <p>@item.Fragrance?.Brand</p>

            <div class="tags">
                <p class="btn-primary">@item.Season</p>
                <p class="btn-primary">@item.Occasion</p>
            </div>

            <p>⭐ @item.Rating</p>


        </div>
    }
</div>


@code {

    // List that holds all vault items for the current user
    private List<VaultItem> vault = new();

    // Runs when the component is initialized
    protected override async Task OnInitializedAsync()
    {
        // Retrieve the current authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // If the user is not authenticated, redirect to login page
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        // Load the user's vault items
        await LoadVault();
    }

    // Loads all vault items for the current user
    private async Task LoadVault()
    {
        // Debug log to indicate function execution
        Console.WriteLine("LOAD VAULT CLICKED");

        // Get the current user's ID
        var userId = await GetUserId();

        Console.WriteLine($"UserId: {userId}");

        // If no user ID is found, exit early
        if (string.IsNullOrEmpty(userId))
        {
            Console.WriteLine("User not logged in");
            return;
        }

        // Query the database for vault items belonging to this user
        // Include fragrance details for display purposes
        vault = await _context.VaultItems
            .Where(v => v.UserId == userId)
            .Include(v => v.Fragrance)
            .ToListAsync();

        // Log the number of items retrieved
        Console.WriteLine($"Items loaded: {vault.Count}");
    }

    // Deletes a vault item by its ID
    private async Task DeleteItem(int id)
    {
        // Find the item in the database
        var item = await _context.VaultItems.FindAsync(id);

        // If the item exists, remove it
        if (item != null)
        {
            _context.VaultItems.Remove(item);
            await _context.SaveChangesAsync();
        }

        // Reload vault after deletion to update UI
        await LoadVault(); 
    }

    // Retrieves the current user's ID from authentication claims
    private async Task<string?> GetUserId()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Return the NameIdentifier claim (unique user ID)
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

}
