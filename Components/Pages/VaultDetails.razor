@page "/vault/{Id:int}"
@rendermode InteractiveServer


@inject AppDbContext _context
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

@using FragranceVault.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using FragranceVault.Data

<PageTitle>@item?.Fragrance?.Name</PageTitle>


@if (item == null)
{
    <p>Loading...</p>
}
else
{
    <div class="details">

        <div class="details-image">
            <img src="@item.Fragrance?.ImageUrl" alt="@item.Fragrance?.Name - @item.Fragrance?.Brand" />
        </div>
        <div class="details-info">
            <h1>@item.Fragrance?.Name</h1>
            <p>@item.Fragrance?.Brand</p>

            <hr />

            <div class="luxe-input-wrapper static-label">
                <label for="buyDateField" class="luxe-label">Buy Date</label>
                <input type="date" id="buyDateField" class="luxe-input" @bind="buyDate" />
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper static-label" >
                <label for="expDateField" class="luxe-label">Expiration Date</label>
                <input type="date" id="expDateField" class="luxe-input" @bind="expirationDate" />
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper static-label">
                <label for="notesField" class="luxe-label">Notes</label>
                <textarea id="notesField" class="luxe-input luxe-textarea" placeholder="Describe the olfactory development, performance, and memory associations..." @bind="notes"></textarea>
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper">
                <input type="text" id="seasonField" class="luxe-input" placeholder=" " autocomplete="off" @bind="season" />
                <label for="seasonField" class="luxe-label">Season</label>
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper" style="margin-top: 32px;">
                <input type="text" id="occasionField" class="luxe-input" placeholder=" " autocomplete="off" @bind="occasion" />
                <label for="occasionField" class="luxe-label">Occasion</label>
                <span class="luxe-underline"></span>
            </div>

            <div class="luxe-input-wrapper" style="margin-top: 32px;">
                <input type="number" id="ratingField" class="luxe-input" placeholder=" " min="0" max="5" step="0.5" @bind="rating" />
                <label for="ratingField" class="luxe-label">Rating (0 - 5)</label>
                <span class="luxe-underline"></span>
            </div>

            <br />
            <div class="button-container">
                
                <button class="btn-secondary" @onclick="ConfirmDelete">
                    Delete
                </button>
                <button @onclick="SaveChanges" class="btn-primary">
                    Save
                </button>
            </div>

            <br />

            <p>@message</p>
        </div>
    </div>
}

@code {
    // Route parameter used to identify which vault item to load
    [Parameter] public int Id { get; set; }

    // Holds the current vault item being displayed
    private VaultItem? item;

    // Local variables bound to form inputs
    private DateTime buyDate;
    private DateTime? expirationDate;
    private string notes = "";
    private string season = "";
    private string occasion = "";
    private int rating;

    // Message displayed to the user (e.g., save confirmation)
    private string message = "";

    // Runs when the component initializes
    protected override async Task OnInitializedAsync()
    {
        // Retrieve authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Redirect to login if user is not authenticated
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true); 
            return;
        }

        // Load the vault item data
        await LoadItem();
    }

    // Loads the vault item for the current user
    private async Task LoadItem()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Get the current user's ID from claims
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) return;

        // Retrieve the vault item that matches the ID and belongs to the current user
        item = await _context.VaultItems
            .Where(v => v.Id == Id && v.UserId == userId)
            .Include(v => v.Fragrance)
            .FirstOrDefaultAsync();

        // If the item is found, populate the form fields
        if (item != null)
        {
            buyDate = item.BuyDate;
            expirationDate = item.ExpirationDate;
            notes = item.PersonalNotes;
            season = item.Season;
            occasion = item.Occasion;
            rating = item.Rating;
        }
    }

    // Saves changes made to the vault item
    private async Task SaveChanges()
    {
        if (item == null) return;

        // Update the item with values from the form
        item.BuyDate = buyDate;
        item.ExpirationDate = expirationDate;
        item.PersonalNotes = notes;
        item.Season = season;
        item.Occasion = occasion;
        item.Rating = rating;

        // Persist changes to the database
        await _context.SaveChangesAsync();

        // Display confirmation message
        message = "Saved successfully";
    }

    // Deletes the current vault item
    private async Task DeleteItem()
    {
        if (item == null) return;

        // Retrieve authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Get the current user's ID
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        // Ensure the item belongs to the current user before deleting
        if (item.UserId != userId)
        {
            message = "Unauthorized";
            return;
        }

        // Remove the item from the database
        _context.VaultItems.Remove(item);
        await _context.SaveChangesAsync();

        // Redirect back to vault list after deletion
        Navigation.NavigateTo("/vault");
    }

    // Displays a confirmation dialog before deleting the item
    private async Task ConfirmDelete()
    {
        // Show browser confirmation dialog
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this item?");

        // If user confirms, proceed with deletion
        if (confirmed)
        {
            await DeleteItem();
        }
    }
}